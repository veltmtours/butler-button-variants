# Veltm Supabase project — Butler Button booking API
#
# Both values are SAFE TO COMMIT (already public on veltmtours.com,
# protected server-side via CORS allow-list + RLS), but env-var
# hygiene is still preferred.
#
# Currently the modal snippet inlines these constants directly in
# zoho-inject/*v3*.js and zoho-inject/_modal-snippet.js (search for
# `API_CFG`). When/if a build step is added, source from these env
# vars and substitute at build time.
#
# DO NOT add the service-role key or BUTLER_BOOKING_API_KEY here.
# Those are server-only secrets and must never appear in this repo.

VELTM_SUPABASE_URL=https://glhbwpfkykycexyygwjj.supabase.co
VELTM_SUPABASE_ANON_KEY=


# ─────────────────────────────────────────────────────────────────────
# Demo / 15-minute-meeting request forms  (tools/request_forms.py)
#
# Powers POST /forms/request, used by the "Request a demo" and
# "Request a 15-minute meeting" buttons on
# proposed/hotel-concierge-program.html. Each submission gets a unique
# request ID that goes into BOTH the mail to the team and the
# acknowledgement to the requester.
#
# Mail goes out via the VELTM Tours ZeptoMail account. Pick ONE of the
# two transports below. The API is preferred: it needs only outbound
# 443, and it is chosen automatically whenever ZEPTOMAIL_TOKEN is set.
#
# IMPORTANT — the two addresses do different jobs:
#   MAIL_FROM      must sit on a domain VERIFIED in ZeptoMail, which is
#                  veltmtours.com. butlerbutton.co is not set up there.
#   BB_TEAM_EMAIL  is just a recipient. ZeptoMail does not verify
#                  destinations, so this stays on butlerbutton.co.
# So mail is sent from veltmtours.com and lands in the Butler Button
# inbox; the requester's acknowledgement works the same way.
#
# Check a deployment without submitting the form:
#   heroku run python tools/request_forms.py            # print config
#   heroku run python tools/request_forms.py you@x.com  # send a test
#
# The token / SMTP password are real secrets: set them with
# `heroku config:set`, never commit the filled-in values. With neither
# transport configured the endpoint returns 503 and logs the full
# submission to stderr, and the page falls back to a pre-filled
# mailto — nothing is silently dropped.
# ─────────────────────────────────────────────────────────────────────

# ── Option A (preferred): ZeptoMail HTTPS API ────────────────────────
# ZeptoMail console -> Mail Agents -> your agent -> "Send Mail Token".
# Paste the token with or without its "Zoho-enczapikey " prefix.
ZEPTOMAIL_TOKEN=
# The account is in the INDIA region (its console shows smtp.zeptomail.in),
# so the default API host is api.zeptomail.in. A token is region-scoped —
# calling the wrong regional host fails auth and looks like a bad token.
# Other regions: api.zeptomail.com (global), api.zeptomail.eu.
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

# ── Option B: ZeptoMail SMTP relay (or any other SMTP server) ────────
# Straight off the console's "SMTP" tab. Note these are DIFFERENT
# credentials from the API token above - the SMTP password will not
# authenticate the API, and vice versa.
# SMTP_HOST=smtp.zeptomail.in
# SMTP_PORT=587
# SMTP_USER=emailapikey
# SMTP_PASSWORD=          # the console's "Password 1"
# starttls (default, port 587) | ssl (port 465) | none (local testing)
# SMTP_SECURITY=starttls

# Force a transport instead of auto-selecting: auto (default) | zeptomail | smtp
# BB_MAIL_TRANSPORT=auto

# Sender. Must be on a ZeptoMail-verified domain — see the note above.
# (SMTP_FROM / SMTP_FROM_NAME still work as older aliases.)
MAIL_FROM=partners@veltmtours.com
MAIL_FROM_NAME=Butler Button

# Where submissions land, and who replies reach. Any domain is fine.
BB_TEAM_EMAIL=partners@butlerbutton.co
BB_SITE_URL=https://butlerbutton.co

# Domains ZeptoMail will accept as senders. Only used to warn early at
# startup; widen it if another domain gets verified.
# BB_VERIFIED_SENDER_DOMAINS=veltmtours.com

# Troubleshooting: return the mail provider's own rejection reason in the
# API response (and so in the browser console) instead of only logging it.
# Credentials are redacted, but visitors should not see provider errors —
# turn this on to diagnose a setup, then turn it off.
# BB_FORMS_DEBUG=1

# Optional: per-IP throttle, and extra browser origins allowed to post
# (same-origin posts need no entry here).
# BB_FORMS_RATE_MAX=5
# BB_FORMS_RATE_WINDOW=600
# BB_FORMS_ALLOWED_ORIGINS=https://butlerbutton.co,https://www.butlerbutton.co


# ─────────────────────────────────────────────────────────────────────
# Demo-call booking  (tools/booking.py)
#
# Powers GET /booking/slots and POST /booking/book, used by "Book a demo"
# on proposed/hotel-concierge-program.html. A visitor picks an open time;
# the server puts a call with a Google Meet link on ONE shared Google
# account's calendar, and Google emails the invitation to the visitor
# and to the team guests below.
#
# Until the three GOOGLE_* values are set, booking is simply off and
# "Book a demo" opens the plain request form, exactly as before. The
# same happens whenever Google cannot be reached, so a booking problem
# never costs a lead.
#
# No password is involved. The server holds a revocable key (an OAuth
# refresh token) that can only read free/busy and manage events. Set
# all of these with `heroku config:set` or in the Heroku dashboard
# (Settings -> Config Vars). NEVER commit the filled-in values, and
# never paste them into a chat or an email.
#
# ── One-time setup, done in a browser as the common Google account ──
# (Google renames these screens now and then; the steps stay the same.)
#
#  1. console.cloud.google.com -> create a project, e.g. "Butler Button
#     booking". APIs & Services -> Library -> enable "Google Calendar API".
#  2. OAuth consent screen: user type "External" for an ordinary
#     @gmail.com account ("Internal" if it is a Google Workspace account).
#     Then set its publishing status to "In production".
#     DO THIS BEFORE STEP 4: a key made while the screen is still in
#     "Testing" stops working after 7 days.
#  3. Credentials -> Create credentials -> OAuth client ID -> type
#     "Web application". Add this Authorised redirect URI exactly:
#         https://developers.google.com/oauthplayground
#     Copy the Client ID and Client secret.
#  4. Open https://developers.google.com/oauthplayground . Gear icon ->
#     tick "Use your own OAuth credentials" -> paste the ID and secret.
#     (Without that tick the key is revoked after a day.) In "Input your
#     own scopes" paste both, separated by a space:
#         https://www.googleapis.com/auth/calendar.events
#         https://www.googleapis.com/auth/calendar.freebusy
#     Authorize APIs -> sign in as the common account -> Allow. Google
#     warns the app is unverified; that is expected, since this one
#     account is its only user (Advanced -> continue).
#     "Exchange authorization code for tokens" -> copy the Refresh token.
#  5. Set the Config Vars below, then check without booking anything:
#         heroku run python tools/booking.py
#     It should list the next open times.
#
# ── On the common account itself ──
#  * Set its profile name to "Butler Button": visitors see it as the
#    organiser of the call.
#  * Share its calendar with the three of you.
#  * Calendar settings -> "Add invitations to my calendar" -> only from
#    known senders, so a stranger cannot block times by sending invites.
#  * To block time (a holiday, a busy afternoon) add any event to that
#    calendar. To free a time, delete the event; a visitor declining the
#    invitation does not free it.
#
# ── Things to check on the first real booking ──
#  * The visitor's invitation does not show the three team addresses.
#  * Book with a non-Google email address and try to join the Meet while
#    nobody is signed in as the common account. On a personal Google
#    account only the organiser may be able to admit someone who has to
#    "ask to join"; if so, whoever takes the call should join signed in
#    as the common account.
#
# Worth knowing: the invitation text is fixed. Nothing the visitor types
# is put in it (Google would email that text to whatever address was
# typed into the form). So on your own calendars the call shows its
# time, Meet link and booking reference but not who booked: that is in
# the lead email at partners@ and on the common calendar's copy.
# ─────────────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Invited to every call, hidden from the visitor. Comma-separated.
BB_BOOKING_TEAM_GUESTS=

# Everything below is optional; these are the defaults.
# Which calendar on the common account holds the calls.
# BB_BOOKING_CALENDAR_ID=primary
# The bookable window. A zone name, so daylight saving is followed.
# BB_BOOKING_TZ=America/New_York
# BB_BOOKING_HOURS=08:00-19:00
# BB_BOOKING_WEEKDAYS=mon-fri
# BB_BOOKING_MINUTES=30
# Earliest a call can start from now, and how far ahead can be booked.
# BB_BOOKING_MIN_NOTICE_HOURS=4
# BB_BOOKING_DAYS_AHEAD=30
# Brakes: bookings per day in total, and per visitor address per window.
# BB_BOOKING_DAILY_MAX=25
# BB_BOOKING_RATE_MAX=5
# BB_BOOKING_RATE_WINDOW=600
# Off switch that leaves the credentials in place (page uses its form).
# BB_BOOKING_ENABLED=0
